    "eslint-plugin-sonarjs": "3.0.5",
    "eslint-plugin-unicorn": "62.0.0",
    "eslint-typegen": "2.3.0",
    "fast-check": "4.8.0",
    "globals": "16.5.0",
    "jiti": "2.6.1",
