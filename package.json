{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "abstract-algebra",
  "version": "0.0.2",
  "license": "MIT",
  "description": "Abstract algebra structures and components.",
  "homepage": "https://github.com/oliveryasuna/abstract-algebra",
  "author": "Oliver Yasuna",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliveryasuna/abstract-algebra.git"
  },
  "bugs": "https://github.com/oliveryasuna/abstract-algebra/issues",
  "keywords": [
    "abstract-algebra",
    "algebra",
