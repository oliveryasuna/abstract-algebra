    "@typescript-eslint/utils": "8.56.1",
    "@vitest/coverage-v8": "4.1.6",
    "bun-types": "1.3.13",
    "eslint": "9.39.2",
    "eslint-config-flat-gitignore": "2.1.0",
    "eslint-flat-config-utils": "2.1.4",
    "eslint-import-resolver-typescript": "4.4.4",
